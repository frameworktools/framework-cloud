# Framework Cloud, self-hosted with Docker. Copy to .env and fill in.
# GitHub, the documents bucket, and email can also be set up later from
# Server setup in the app; any variable set here wins over that page.

APP_NAME="Framework Cloud"
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
# Back it up: values saved on the Server setup page are encrypted with it.
APP_KEY=
# The address people use. With a domain in SERVER_NAME, Caddy gets an HTTPS
# certificate automatically (ports 80 and 443 must reach this machine).
APP_URL=https://framework.example.edu
SERVER_NAME=framework.example.edu
# For a quick local try instead:
#   APP_URL=http://localhost:8080
#   SERVER_NAME=:80
#   HTTP_PORT=8080
# HTTP_BIND=127.0.0.1 makes the server reachable only from this machine.
# HTTP_BIND=0.0.0.0

FW_MODE=self
# The first admin. Sign in with a link printed by:
#   docker compose exec app php artisan fw:login-link you@example.edu
FW_ADMIN_EMAIL=
FW_ADMIN_NAME=
# "closed" stops new sign-ups; admins can still create accounts with
#   docker compose exec app php artisan fw:login-link someone@example.edu --create
FW_REGISTRATION=open
# Password sign-in, alongside email links and passkeys. Set a password from
# the server with: docker compose exec app php artisan fw:password you@example.edu
FW_PASSWORDS=true

# Single-user mode: no sign-in screen; every request from this computer is
# signed in as FW_ADMIN_EMAIL. Needs a localhost APP_URL and HTTP_BIND=127.0.0.1.
# The container finds the Docker network's address on its own.
# See docs/guide/running-at-home.md.
# FW_SINGLE_USER=true

DB_DATABASE=framework_cloud
DB_USERNAME=framework_cloud
# Any long random string, e.g. from: openssl rand -hex 24
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_LEVEL=warning

# Email (or set it up on the Server setup page). Until it works, sign in
# with fw:login-link.
MAIL_MAILER=log
# MAIL_FROM_ADDRESS=noreply@example.edu
# MAIL_FROM_NAME="Framework Cloud"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Published documents bucket (or set it up on the Server setup page).
# Without one, documents are stored in the "storage" volume.
# FW_BUCKET_NAME=
# FW_BUCKET_ENDPOINT=
# FW_BUCKET_REGION=auto
# FW_BUCKET_KEY=
# FW_BUCKET_SECRET=
# FW_DOCUMENTS_BASE_URL=

# GitHub App (or create one from the Server setup page)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY=
