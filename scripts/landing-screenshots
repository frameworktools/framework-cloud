#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["playwright>=1.48"]
# ///
"""Capture the Framework Cloud screenshots on the homepage.

Seeds the demo account (database/seeders/LandingDemoSeeder.php), builds the
frontend, signs in as Ada Lovelace with a one-time link, and captures each
screen in light and dark at 1280x830 CSS pixels and 2x scale. Each screen is
written to public/images/landing/cloud/ as {name}-{theme}.webp (2560 wide) and
{name}-{theme}-1280.webp. PNGs for review go to /tmp/landing-screenshots.

    scripts/landing-screenshots                 every screen
    scripts/landing-screenshots versions sharing   only these screens
    scripts/landing-screenshots --no-seed --no-build

Needs Herd serving https://framework-cloud.test, Google Chrome, uv, and
cwebp. A Vite dev server's public/hot file is moved aside while capturing so
pages load the built assets, then put back.
"""

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

from playwright.sync_api import sync_playwright

ROOT = Path(__file__).resolve().parent.parent
BASE = "https://framework-cloud.test"
EMAIL = "ada@example.org"
OUT = ROOT / "public/images/landing/cloud"
PNG = Path("/tmp/landing-screenshots")
WIDTH, HEIGHT = 1280, 830


def php(*args: str) -> str:
    return subprocess.run(["php", "artisan", *args], cwd=ROOT, check=True, capture_output=True, text=True).stdout


def ids() -> dict:
    """The demo account's record ids the screen URLs need."""
    code = r"""
        $u = App\Models\User::where('email', '%s')->firstOrFail();
        $p = $u->projects()->where('slug', 'penguin-study')->firstOrFail();
        $docs = App\Models\Document::where('project_id', $p->id)->pluck('id', 'slug');
        echo json_encode([
            'blueprint' => App\Models\Blueprint::where('user_id', $u->id)->value('id'),
            'model' => $docs['penguin-body-mass'],
            'collection' => App\Models\Collection::where('project_id', $p->id)->value('id'),
            'collection_key' => App\Models\Collection::where('project_id', $p->id)->value('key'),
            'structure' => App\Models\Facet::where('kind', 'structure')->where('user_id', $u->id)->value('id'),
        ]);
    """ % EMAIL
    return json.loads(php("tinker", "--execute", code).strip().splitlines()[-1])


def screens(i: dict) -> list[tuple]:
    """(name, path, prepare). prepare(page) clicks or scrolls before the capture."""
    bp = f"/blueprints/{i['blueprint']}/edit?tab="

    def scroll_to(selector: str, offset: int = 24):
        def go(page):
            page.evaluate(
                "([s, o]) => { const el = document.querySelector(s); window.scrollTo(0, el.getBoundingClientRect().top + window.scrollY - o); }",
                [selector, offset],
            )
        return go

    def heading(text: str, offset: int = 24):
        def go(page):
            page.get_by_role("heading", name=text, exact=True).first.evaluate(
                "(el, o) => window.scrollTo(0, el.getBoundingClientRect().top + window.scrollY - o)", offset
            )
        return go

    def collapse(name: str):
        def go(page):
            page.locator(f'details[aria-label="{name}"] > summary').first.click()
        return go

    def fill_name(page):
        page.get_by_label("Project name").fill("Bill size study")
        page.get_by_label("Description (optional)").fill("Bill length and depth across the three species.")
        page.locator("body").click(position={"x": 5, "y": 5})

    return [
        ("blueprints", "/blueprints", None),
        ("blueprint-packages", bp + "packages", collapse("Package sets")),
        ("blueprint-git", bp + "git", None),
        ("blueprint-quarto", bp + "quarto", None),
        ("blueprint-connections", bp + "connections", None),
        ("blueprint-skills", bp + "skills", None),
        ("project-defaults", "/settings/blueprint", None),
        ("new-project-start", "/projects/create", None),
        ("new-project", f"/projects/create?blueprint={i['blueprint']}&stage=project&tab=structure", heading("Project structure", 104)),
        ("new-project-review", f"/projects/create?blueprint={i['blueprint']}&stage=review", fill_name),
        ("dashboard", "/dashboard", None),
        ("dashboard-commands", "/dashboard", heading("Quick commands", 40)),
        ("project-overview", "/projects/penguin-study", None),
        ("project-registry", "/projects/penguin-study", heading("Connections")),
        ("pieces-skills", "/skills", None),
        ("pieces-gitignore", f"/structures/{i['structure']}/edit?tab=gitignore", None),
        ("pieces-package-sets", "/package-sets", None),
        ("published-index", "/published", None),
        ("published-model", "/@ada/penguin-study/penguin-body-mass", None),
        ("published-figure", "/@ada/penguin-study/flipper-and-mass", None),
        ("versions", f"/artifacts/{i['model']}?tab=versions", None),
        ("sharing", f"/artifacts/{i['model']}?tab=sharing", None),
        ("collection-edit", f"/collections/{i['collection']}/edit", None),
        ("collection", f"/c/{i['collection_key']}", None),
    ]


# Herd's "Edit with Herd" widget, and anything else that only exists locally
HIDE = """
    for (const el of document.querySelectorAll('body *')) {
        if (el.shadowRoot && el.shadowRoot.innerHTML.includes('Herd')) el.remove();
    }
    document.querySelectorAll('[class*=phpdebugbar], #herd-dump').forEach((el) => el.remove());
    // Links and commands name framework.pub, as they do there
    const local = /https?:\/\/framework(-cloud)?\.test/g;
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) {
        if (walker.currentNode.nodeValue.includes('.test')) walker.currentNode.nodeValue = walker.currentNode.nodeValue.replace(local, 'https://framework.pub');
    }
    document.querySelectorAll('input, textarea').forEach((el) => { if (el.value.includes('.test')) el.value = el.value.replace(local, 'https://framework.pub'); });
"""


def show_downloads(route):
    """framework.pub builds zips; a local server without the scaffolder hides that card."""
    response = route.fetch()
    body = response.text()
    route.fulfill(response=response, body=body.replace("&quot;downloads&quot;:false", "&quot;downloads&quot;:true").replace('"downloads":false', '"downloads":true'))


def webp(png: Path, name: str) -> None:
    subprocess.run(["cwebp", "-quiet", "-q", "82", "-m", "6", str(png), "-o", str(OUT / f"{name}.webp")], check=True)
    subprocess.run(["cwebp", "-quiet", "-q", "82", "-m", "6", "-resize", str(WIDTH), str(HEIGHT), str(png), "-o", str(OUT / f"{name}-1280.webp")], check=True)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("only", nargs="*", help="screen names to capture")
    parser.add_argument("--no-seed", action="store_true")
    parser.add_argument("--no-build", action="store_true")
    args = parser.parse_args()

    if not args.no_seed:
        php("db:seed", "--class=Database\\Seeders\\LandingDemoSeeder")
    if not args.no_build:
        subprocess.run(["npm", "run", "build"], cwd=ROOT, check=True, capture_output=True)

    i = ids()
    todo = [s for s in screens(i) if not args.only or s[0] in args.only]
    PNG.mkdir(parents=True, exist_ok=True)
    OUT.mkdir(parents=True, exist_ok=True)

    hot = ROOT / "public/hot"
    aside = ROOT / "public/hot.landing-screenshots"
    if hot.exists():
        shutil.move(hot, aside)
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(channel="chrome")
            link = re.search(r"https?://\S+?(/auth/magic/\S+)", php("fw:login-link", EMAIL)).group(1)
            ctx = browser.new_context(ignore_https_errors=True)
            page = ctx.new_page()
            page.goto(BASE + link)
            page.locator("form button[type=submit]").click()
            page.wait_for_url(lambda url: "/auth/magic" not in url)
            state = ctx.storage_state()
            ctx.close()

            for theme in ("light", "dark"):
                ctx = browser.new_context(
                    ignore_https_errors=True, storage_state=state, color_scheme=theme,
                    viewport={"width": WIDTH, "height": HEIGHT}, device_scale_factor=2,
                )
                ctx.route(re.compile(r".*/projects/penguin-study(\?.*)?$"), show_downloads)
                page = ctx.new_page()
                for name, path, prepare in todo:
                    page.goto(BASE + path, wait_until="networkidle")
                    if "/login" in page.url:
                        sys.exit(f"{name}: not signed in")
                    page.evaluate(HIDE)
                    if prepare:
                        prepare(page)
                    page.wait_for_timeout(400)
                    page.evaluate(HIDE)
                    png = PNG / f"{name}-{theme}.png"
                    page.screenshot(path=str(png))
                    webp(png, f"{name}-{theme}")
                    print(f"{name}-{theme}")
                ctx.close()
            browser.close()
    finally:
        if aside.exists():
            shutil.move(aside, hot)


if __name__ == "__main__":
    main()
