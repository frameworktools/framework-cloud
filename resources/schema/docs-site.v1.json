{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework.pub/schema/docs-site.v1.json",
  "title": "Framework docs site.yml",
  "description": "The hand-written site.yml at the top of a docs-site folder. framework-cloud checks it on import; the format is described in the R package's inst/schema/docs-site.md.",
  "type": "object",
  "required": ["product", "title", "sections"],
  "additionalProperties": false,
  "properties": {
    "product": { "enum": ["r", "py", "cli"] },
    "title": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string" },
    "repository": { "type": "string", "pattern": "^https://" },
    "install": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "reference": { "type": "boolean" }
        }
      }
    }
  }
}
