# Framework Cloud, installed on a server without Docker. Copy to .env, run
# php artisan key:generate, and fill in the values below. GitHub, the
# documents bucket, and email can also be set up later from Server setup in
# the app; any variable set here wins over that page.
# Guide: https://framework.pub/docs/install-manual

APP_NAME="Framework Cloud"
APP_ENV=production
APP_DEBUG=false
# Back it up: values saved on the Server setup page are encrypted with it.
APP_KEY=
# The public HTTPS address
APP_URL=https://framework.example.edu
# Behind a reverse proxy that handles HTTPS, trust it so the app builds
# https:// links. Use the proxy's address, a CIDR range, or *.
# TRUSTED_PROXIES=127.0.0.1

FW_MODE=self
# The first admin. Sign in with a link printed by:
#   php artisan fw:login-link you@example.edu
FW_ADMIN_EMAIL=
FW_ADMIN_NAME=
# "closed" stops new sign-ups; admins can still create accounts with
#   php artisan fw:login-link someone@example.edu --create
FW_REGISTRATION=open
# Password sign-in, alongside email links and passkeys. Set a password with:
#   php artisan fw:password you@example.edu
FW_PASSWORDS=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=framework_cloud
DB_USERNAME=framework_cloud
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_LEVEL=warning

# Email (or set it up on the Server setup page). Until it works, sign in
# with fw:login-link.
MAIL_MAILER=log
# MAIL_FROM_ADDRESS=noreply@example.edu
# MAIL_FROM_NAME="Framework Cloud"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Project downloads: the scaffolder container. Without it, ZIP download is
# unavailable on Projects > New project.
# SCAFFOLDER_URL=http://127.0.0.1:8100
# SCAFFOLDER_TOKEN=

# Published documents bucket (or set it up on the Server setup page).
# Without one, documents are stored in storage/.
# FW_BUCKET_NAME=
# FW_BUCKET_ENDPOINT=
# FW_BUCKET_REGION=auto
# FW_BUCKET_KEY=
# FW_BUCKET_SECRET=
# FW_DOCUMENTS_BASE_URL=

# GitHub App (or create one from the Server setup page)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY=

# OAuth signing keys for connected AI apps (/mcp) are made in storage/ on
# first use. To supply your own instead:
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
