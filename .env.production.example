# framework.pub production environment (Forge site env template).
# Fill in Forge → Site → Environment. Secrets never live in git.

APP_NAME="Framework Cloud"
APP_ENV=production
APP_KEY=            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://framework.pub
FW_DOCS_HOST=r.framework.pub   # docs site host (Forge site alias + cert; CNAME r -> framework.pub)

# framework.pub is the hosted server: publishing is a paid feature
# (php artisan fw:publishing <email> turns it on until billing exists).
# Every credential below is set here, so the admin setup page shows them
# as read-only; nothing for framework.pub is saved in the database.
FW_MODE=hosted

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=framework_pub
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail: SES (decided 2026-08-27). Credentials = IAM user apps/framework-ses,
# stored in ~/System/ansible/vault/secrets.yml under framework.ses_*.
# Prereqs (console): verify framework.pub identity + DKIM CNAMEs in Cloudflare,
# request SES production access. Magic-link auth = mail is a hard dependency.
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=hello@framework.pub
MAIL_FROM_NAME="Framework Cloud"
AWS_ACCESS_KEY_ID=      # framework.ses_access_key_id
AWS_SECRET_ACCESS_KEY=  # framework.ses_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# Documents storage: Cloudflare R2 (bucket framework-pub, minted 2026-08-27).
# Mint a BUCKET-SCOPED token in the Cloudflare dash for prod; do not reuse the
# account-scoped flint-r2 token.
FW_DOCUMENTS_DISK=r2
FW_DOCUMENTS_BASE_URL=https://files.framework.pub   # R2 custom domain (attach in CF dash)
R2_BUCKET=framework-pub
R2_ENDPOINT=https://4d70d0f810424217b99890dba7bebc5f.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

SANCTUM_TOKEN_PREFIX=fw_

# Prometheus scrape token (vault: framework.monitoring_metrics_token)
MONITORING_METRICS_TOKEN=

# Framework GitHub App (a GitHub App, not an OAuth app). Settings:
#   Callback URL: https://framework.pub/auth/github/callback
#   Expire user authorization tokens: on
#   Request user authorization (OAuth) during installation: on
#   Webhook URL: https://framework.pub/api/github/webhook (secret below)
#   Repository permissions: Administration write, Contents write,
#     Workflows write, Actions write, Metadata read
#   Account permissions: Email addresses read
#   Subscribe to events: Workflow run
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://framework.pub/auth/github/callback
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Optional override of the framework commit the scaffold workflow installs
# (default pinned in config/services.php). Set it empty to turn GitHub
# scaffolding off; sign-in and import/publish still work.
# GITHUB_FRAMEWORK_SHA=

# Flux Pro composer credentials (used by forge/deploy.sh)
FLUX_USERNAME=
FLUX_LICENSE_KEY=
